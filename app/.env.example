# ─── Store ────────────────────────────────────────────────────────────────
# "pg" usa Postgres/Supabase (produzione). "memory" tiene tutto in RAM (demo/test).
STORE=memory

# Connessione Postgres/Supabase. Da Supabase: Project Settings → Database → Connection string (URI).
# Esempio: postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# TLS verso il DB. "verify" (default) verifica il certificato del server (sicuro).
# "no-verify" lo disattiva: SOLO per debug, espone a MITM.
DATABASE_SSL=verify
# Se la verifica fallisce con Supabase, scarica il CA cert (Project Settings → Database →
# SSL configuration) e indica qui il path (relativo alla cartella app/), es: ./certs/supabase-ca.crt
DATABASE_CA_CERT=

# ─── Sorgente transazioni ───────────────────────────────────────────────────
# "mock" = dati finti generati | "csv" = legge da TRANSACTIONS_CSV | "tink" = API Tink (TODO)
SOURCE=mock
TRANSACTIONS_CSV=./sample-data/transactions.csv

# ─── Tink (Open Banking) — da compilare quando l'accesso è validato ──────────
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
TINK_ENVIRONMENT=sandbox

# ─── Notifiche ───────────────────────────────────────────────────────────────
# Canale: console (default) | macos (native, nessun dato esce dalla macchina) | telegram | none
NOTIFY=macos

# Telegram — solo se NOTIFY=telegram. Bot via @BotFather; chat_id da getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Soglia di "avviso vicino al limite": notifica quando speso >= NEAR_THRESHOLD_RATIO * soglia
NEAR_THRESHOLD_RATIO=0.8

# ─── Notion (sincronizzazione opzionale) ─────────────────────────────────────
# off | on (push app → Notion) | two-way (pull da Notion poi push) — aggancio allo scheduler.
# I comandi funzionano comunque: `npm run sync:notion` (push), `npm run sync:notion:2way`
# (bidirezionale), `npm run pull:notion` (solo pull). Anteprima: `npm run sync:notion -- --dry-run`.
# Nota: il primo pull fa solo da "baseline" (fissa il watermark), reagisce agli edit successivi.
NOTION_SYNC=off
# Token dell'integrazione interna Notion (Settings → Connections → Develop → New integration).
NOTION_TOKEN=
# Database esistente delle spese (es. "Spese — tracker") condiviso con l'integrazione:
# riceve le uscite. La categoria è dinamica (usa i nomi reali dell'app).
NOTION_DB_SPESE=
# Tabella "Categorie & Budget": lascia vuoto e imposta NOTION_PARENT_PAGE per farla
# creare all'app sotto quella pagina; oppure indica l'ID di un database esistente.
NOTION_DB_CATEGORIES=
NOTION_PARENT_PAGE=

# ─── Server / scheduler ──────────────────────────────────────────────────────
PORT=3000
# Espressione cron per il polling (default: ogni 5 ore)
POLL_CRON=0 */5 * * *
